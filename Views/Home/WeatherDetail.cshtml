@model WeatherData
@using System.Globalization

@{
    ViewData["Title"] = $"Weather in {Model.City}";
    var isFavoriteCity = ViewBag.IsFavoriteCity as bool? ?? false;

    var lat = Model.Latitude;
    var lon = Model.Longitude;
    const double latDelta = 2.4;
    const double lonDelta = 4.2;

    var minLat = Math.Max(-90d, lat - latDelta);
    var maxLat = Math.Min(90d, lat + latDelta);
    var minLon = Math.Max(-180d, lon - lonDelta);
    var maxLon = Math.Min(180d, lon + lonDelta);

    var bboxParam = string.Join("%2C", new[]
    {
        minLon.ToString("F4", CultureInfo.InvariantCulture),
        minLat.ToString("F4", CultureInfo.InvariantCulture),
        maxLon.ToString("F4", CultureInfo.InvariantCulture),
        maxLat.ToString("F4", CultureInfo.InvariantCulture)
    });

    var markerParam = string.Join("%2C", new[]
    {
        lat.ToString("F4", CultureInfo.InvariantCulture),
        lon.ToString("F4", CultureInfo.InvariantCulture)
    });

    var mapEmbedUrl = $"https://www.openstreetmap.org/export/embed.html?bbox={bboxParam}&layer=mapnik&marker={markerParam}";
}

<div class="page-section">
    <div class="row">
        <div class="col-lg-9 col-xl-8 mx-auto">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success app-alert" role="alert">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger app-alert" role="alert">
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="card app-card weather-card">
                <div class="card-body p-4 p-md-5">
                    <div class="row">
                        <div class="col-md-6">
                            <h1 class="h2 mb-2">@Model.City, @Model.Country</h1>
                            <h2 class="h5 text-muted text-capitalize mb-3">@Model.Description</h2>
                            <hr>
                            <div class="weather-metrics">
                                <p><strong>Temperature:</strong> @Model.Temperature.ToString("F1")&deg;C</p>
                                <p><strong>Feels Like:</strong> @Model.FeelsLike.ToString("F1")&deg;C</p>
                                <p><strong>Humidity:</strong> @Model.Humidity%</p>
                                <p><strong>Pressure:</strong> @Model.Pressure hPa</p>
                                <p><strong>Wind Speed:</strong> @Model.WindSpeed.ToString("F1") m/s</p>
                            </div>
                        </div>
                        <div class="col-md-6 d-flex align-items-center justify-content-center mt-4 mt-md-0">
                            <section class="city-map-panel" aria-label="2D map showing searched city location">
                                <h3 class="h6 mb-2 text-muted">City on Map</h3>
                                <iframe
                                    class="city-map"
                                    title="Map for @Model.City"
                                    src="@mapEmbedUrl"
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"></iframe>
                                <div class="city-map-coordinates text-muted small mt-2">
                                    @Model.City: @Model.Latitude.ToString("F2")&deg;, @Model.Longitude.ToString("F2")&deg;
                                </div>
                            </section>
                        </div>
                    </div>

                    @if (Model.NextHoursForecast.Any())
                    {
                        <div class="mt-4">
                            <h3 class="h5 mb-3">Next 6 Hours Forecast</h3>
                            <div class="hourly-forecast-box">
                                @foreach (var hour in Model.NextHoursForecast)
                                {
                                    <div class="hourly-forecast-item">
                                        <strong class="hourly-forecast-time">@hour.DateTime.ToString("h tt")</strong>
                                        @if (!string.IsNullOrWhiteSpace(hour.IconUrl))
                                        {
                                            <img src="@hour.IconUrl" alt="@hour.Description" class="hourly-forecast-icon" />
                                        }
                                        <div class="hourly-forecast-description text-capitalize">@hour.Description</div>
                                        <div class="hourly-forecast-temperature">@hour.Temperature.ToString("F1")&deg;C</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (Model.NextDaysForecast.Any())
                    {
                        <div class="mt-4">
                            <h3 class="h5 mb-3">Next 2 Days Forecast</h3>
                            <div class="row g-3">
                                @foreach (var day in Model.NextDaysForecast)
                                {
                                    <div class="col-md-6">
                                        <div class="border rounded p-3 h-100 bg-light-subtle">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <strong>@day.Date.ToString("dddd, MMM d")</strong>
                                                @if (!string.IsNullOrWhiteSpace(day.IconUrl))
                                                {
                                                    <img src="@day.IconUrl" alt="@day.Description" style="width:48px;height:48px;" />
                                                }
                                            </div>
                                            <div class="text-capitalize">@day.Description</div>
                                            <div>Min: @day.MinTemperature.ToString("F1")&deg;C</div>
                                            <div>Max: @day.MaxTemperature.ToString("F1")&deg;C</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="mt-4">
                        <small class="text-muted">
                            @if (Model.IsFromCache)
                            {
                                <span class="badge bg-info">Cached Data</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Fresh Data</span>
                            }
                            Last Updated: @Model.RetrievedAt.ToString("g")
                        </small>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex flex-wrap gap-2">
                <form asp-action="@(isFavoriteCity ? "RemoveFavoriteCity" : "AddFavoriteCity")" asp-controller="Home" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="city" value="@Model.City" />
                    <input type="hidden" name="country" value="@Model.Country" />
                    <button type="submit" class="btn @(isFavoriteCity ? "btn-outline-danger" : "btn-outline-primary")">
                        @(isFavoriteCity ? "Remove From Favorites" : "Add To Favorites")
                    </button>
                </form>
                <a href="/" class="btn btn-secondary">Search Another City</a>
            </div>
        </div>
    </div>
</div>
