@{
    ViewData["Title"] = "Weatherman";
    var favoriteCities = ViewBag.FavoriteCities as List<string> ?? new List<string>();
    var recentLocations = ViewBag.RecentLocations as List<WeatherData> ?? new List<WeatherData>();
}

<div class="weather-home">
    <section class="home-hero">
        <div class="home-hero-overlay"></div>
        <div class="home-hero-content">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success app-alert" role="alert">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger app-alert" role="alert">
                    @TempData["ErrorMessage"]
                </div>
            }

            <form asp-action="SearchWeather" asp-controller="Home" method="post" class="hero-search-form">
                @Html.AntiForgeryToken()
                <div class="hero-search-shell">
                    <span class="hero-search-icon" aria-hidden="true">&#128269;</span>
                    <label class="visually-hidden" for="city">City Name</label>
                    <input
                        type="text"
                        class="hero-city-input"
                        id="city"
                        name="city"
                        placeholder="Check the weather on"
                        required>
                    <label class="visually-hidden" for="country">Country</label>
                    <input
                        type="text"
                        class="hero-country-input"
                        id="country"
                        name="country"
                        placeholder="(Optional, e.g GR, US)">
                    <button type="submit" class="hero-search-button">Search</button>
                </div>
            </form>

            @if (ViewData.ModelState.Values.Any(v => v.Errors.Any()))
            {
                <div class="alert alert-danger app-alert mt-3" role="alert">
                    @Html.ValidationSummary(true)
                </div>
            }

            <section class="home-recents mt-4" aria-label="Recent locations">
                <h2 class="recents-title">RECENT LOCATIONS</h2>
                <div class="recent-grid">
                    @foreach (var recent in recentLocations)
                    {
                        <form asp-action="SearchWeather" asp-controller="Home" method="post" class="recent-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="city" value="@recent.City" />
                            @if (!string.IsNullOrWhiteSpace(recent.Country))
                            {
                                <input type="hidden" name="country" value="@recent.Country" />
                            }

                            <button type="submit" class="recent-card">
                                <div class="recent-city">@recent.City</div>
                                <div class="recent-country">@recent.Country</div>
                                <div class="recent-weather-row">
                                    <img src="@recent.IconUrl" alt="@recent.Description" class="recent-icon" />
                                    <span class="recent-temp">@recent.Temperature.ToString("F0")&deg;</span>
                                </div>
                                <div class="recent-feels">RealFeel&reg; @recent.FeelsLike.ToString("F0")&deg;</div>
                            </button>
                        </form>
                    }
                </div>
            </section>

            <section class="card app-card unified-favorites-card mt-4" aria-label="Favorite cities">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h2 class="h5 card-title mb-0">Favorite Cities</h2>
                        <span class="text-muted small">Quickly search your saved locations</span>
                    </div>

                    @if (favoriteCities.Count == 0)
                    {
                        <p class="card-text text-muted mb-0">No favorites yet. Search a city above and click "Add To Favorites".</p>
                    }
                    else
                    {
                        @foreach (var favorite in favoriteCities)
                        {
                            <div class="favorite-item d-flex justify-content-between align-items-center rounded p-3 mb-2">
                                <span>@favorite</span>
                                <div class="d-flex gap-2">
                                    <form asp-action="SearchWeather" asp-controller="Home" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="city" value="@favorite" />
                                        <button type="submit" class="btn btn-sm btn-primary me-1">Search</button>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                </div>
            </section>
        </div>
    </section>
</div>
